# ==============================================================================
# HealthRisk AI & HealthRisk Lab - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS AS NEEDED.
# DO NOT COMMIT REAL API KEYS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8501

# Acquisition APIs (Optional - Mock data used deterministically if omitted)
OPENFDA_API_KEY=
CLINICALTRIALS_EMAIL=researcher@example.com
WHO_GHO_API_URL=https://ghoapi.azureedge.net/api/
CDC_WONDER_API_URL=https://wonder.cdc.gov/controller/datarequest/

# Local MIMIC-IV extract path (Optional)
MIMIC_INGEST_PATH=./data/raw/mimic_iv

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=healthrisk-ai-evaluation

# DVC Remote Storage (Optional)
DVC_REMOTE_URL=s3://healthrisk-ai-dvc/data
